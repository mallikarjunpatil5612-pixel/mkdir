# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-key-change-this-in-production-min32chars

# Supabase Credentials
# Copy these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
SUPABASE_BUCKET=property-images

# Initial Administrator Credentials (Auto-seeded if no admin exists)
ADMIN_DEFAULT_EMAIL=admin123@gmail.com
ADMIN_DEFAULT_PASSWORD=123456
ADMIN_DEFAULT_NAME=System Administrator
ADMIN_DEFAULT_PHONE=+91 9876543210

